# ==============================================================================
# Picsum Image Gallery — Variables de Entorno y Configuración
# ==============================================================================
# Copia este archivo a `.env` en la raíz del proyecto:
#   cp .env.example .env
# NUNCA subas tu archivo `.env` al repositorio de Git.

# URL base del servicio de imágenes Lorem Picsum (Público y Gratuito)
VITE_PICSUM_API_URL=https://picsum.photos/v2/list

# NOTA SOBRE CREDENCIALES:
# Lorem Picsum (https://picsum.photos) es un servicio CDN público y libre de derechos.
# NO requiere registro, clave de API ni autenticación.
